name = "hn-telegram-bot"
main = "src/index.ts"
compatibility_date = "2024-01-01"
compatibility_flags = ["cache_option_enabled"]
preview_urls = false

# HN digest at 10:30 UTC+8; fresh market brief at 11:00 UTC+8
[triggers]
crons = ["30 2 * * *", "0 3 * * *"]

# KV namespace for cached results and status metadata
[[kv_namespaces]]
binding = "HN_STORIES"
id = "your-kv-namespace-id-here"
preview_id = "your-preview-kv-namespace-id-here"

[vars]
HN_TOP_N = "10"
BRIEF_BASE_URL = "https://your-worker.workers.dev"
